{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnkiContextPayload",
  "description": "Structured technical context and constraints generated by Hermes for Oh My Pi (OMP)",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "timestamp",
    "source",
    "status",
    "requirements",
    "engineering_constraints",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier for this task payload"
    },
    "title": {
      "type": "string",
      "description": "Concise summary of the feature or bugfix"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "Obsidian vault note or prompt reference"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "dispatched", "in_progress", "verified", "completed", "failed"]
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Functional engineering requirements"
    },
    "engineering_constraints": {
      "type": "object",
      "required": ["language"],
      "properties": {
        "language": { "type": "string" },
        "target_framework": { "type": "string" },
        "lsp_server": { "type": "string" },
        "forbidden_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "design_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "file_scope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "required": ["test_commands"],
      "properties": {
        "test_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lint_command": { "type": "string" },
        "build_command": { "type": "string" },
        "success_conditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "context_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "excerpt": { "type": "string" },
          "relevance": { "type": "string" }
        }
      }
    }
  }
}
